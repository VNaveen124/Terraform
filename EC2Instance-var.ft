provider "aws" {
  region = "us-east-1"
}



resource "aws_instance" "instance" {
  ami           = var.inst_ami
  instance_type = var.inst_type
  count         = var.inst_count
  tags = {
    name = "naveeninfra"
  }
}

variable "inst_ami" {

}

variable "inst_type" {

}

variable "inst_count" {

}
